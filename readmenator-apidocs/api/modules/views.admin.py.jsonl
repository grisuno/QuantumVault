{"uid":"views/admin.py::admin","name":"admin","qualname":"admin","kind":"function","file":"views/admin.py","line":186,"end_line":202,"language":"py","signature":"def admin()","params":[],"returns":"","decorators":["admin_bp.route(f'/admin{token}', methods=['GET'])","login_required","role_required('admin', 'superadmin')","limiter.limit('10 per minute')"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Plan catalog read view.","description":"Plan CRUD lives at ``/admin<token>/plans`` and\n``/admin<token>/plans/edit/<name>`` so a single page is not also\na destructive form. This view is now strictly a list of\navailable plans, with a per-row edit link.\n\nUser identity (list, edit, suspend, MFA reset, confirmation\nrotation) is the superadmin panel's job and lives at\n``/superadmin<token>``.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"views/admin.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["models/plans.py::PlanDB.__init__","models/plans.py::PlanDB.get_all_plans"],"called_by":[]}
{"uid":"views/admin.py::superadmin_edit_user","name":"superadmin_edit_user","qualname":"superadmin_edit_user","kind":"function","file":"views/admin.py","line":208,"end_line":307,"language":"py","signature":"def superadmin_edit_user(username)","params":[{"name":"username","annotation":"","default":"","kind":"positional"}],"returns":"","decorators":["admin_bp.route(f'/superadmin{token}/edit/<username>', methods=['GET', 'POST'])","login_required","role_required('superadmin')","limiter.limit('10 per minute')"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Full profile edit for a single user.","description":"Lives under ``/superadmin<token>`` because every field here touches\nidentity directly (role, verifications, quota, subscription). Admin\nrole no longer has access: the superadmin panel is the only place\nthat can rewrite those columns.\n\nFields intentionally NOT editable through this form:\n\n* ``confirmation_token`` — rotated by the resend-confirmation\n  endpoint, never hand-edited (a static token cannot expire).\n* ``phone_verification_code`` — same reason, lives in a hashed\n  column anyway so even a superadmin should not see it.\n* KEM/SRP blob columns (srp_salt, srp_verifier, public_key,\n  encrypted_private_key, kdf_salt) — modifying any of these would\n  silently brick the user's login. The server has no UI to rewrite\n  them and never should.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"views/admin.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["models/user.py::UserDB.__init__","models/user.py::UserDB.get_user","models/user.py::UserDB.update_role","models/user.py::UserDB.update_user","models/user.py::UserDB.update_user_phone_status","views/admin.py::UserEditForm"],"called_by":[]}
