{"uid":"static/js/qv-deniable.js::buildDeniableVault","name":"buildDeniableVault","qualname":"buildDeniableVault","kind":"function","file":"static/js/qv-deniable.js","line":125,"end_line":165,"language":"js","signature":"export async function buildDeniableVault(parameters, slots)","params":[{"name":"parameters","annotation":"","default":"","kind":"positional"},{"name":"slots","annotation":"","default":"","kind":"positional"}],"returns":"","decorators":[],"bases":[],"modifiers":["async"],"visibility":"public","doc":{"summary":"Build a deniable container from a list of slot specifications.","description":"`slots` is an array of `{ passphrase, data }`; `data` may be a string or a\nUint8Array. The array is padded out to `parameters.slot_count` entries with\nrandom, unopenable slots so the container always has the fixed slot count.\nEvery slot's plaintext is padded to `parameters.slot_plaintext_bytes`, so\nevery container is exactly the same size regardless of how much data it\nholds. Throws if more slots are supplied than allowed, or if any slot's\ndata does not fit the fixed slot size.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"static/js/qv-deniable.js","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["static/js/qv-crypto.js::bytesToHex","static/js/qv-crypto.js::randomBytes","static/js/qv-deniable.js::frame","static/js/qv-deniable.js::sealSlot","static/js/qv-deniable.js::toBytes"],"called_by":["static/js/account.js::handleConfigure"]}
