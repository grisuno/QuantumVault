{"uid":"controllers/facade.py","name":"facade.py","qualname":"controllers/facade.py","kind":"module","file":"controllers/facade.py","line":1,"end_line":381,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"QV-FACADE-1 cover facade: configuration, gate hashing, tickets, gate control.","description":"The facade hides QuantumVault behind an innocuous cover application. A\nsecret phrase typed into the cover's search field is the first gate: a\ncorrect phrase issues a short-lived signed ticket and marks the session\n``real`` or ``duress``; either way the ordinary login page is revealed,\nso an onlooker cannot tell which phrase was used.\n\nThis module is the server-side core. It never stores a phrase, never\nechoes one into the audit log, and performs the same Argon2id work for a\nmiss, the real phrase, and the duress phrase so the response is not an\noracle. The zero-knowledge guarantees of SRP-6a and the deniable vault do\nnot depend on this layer.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["controllers/facade.py::GateOutcome","controllers/facade.py::GateDecision","controllers/facade.py::FacadeConfig","controllers/facade.py::GatePhraseHasher","controllers/facade.py::GateTicket","controllers/facade.py::FacadeGate"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
