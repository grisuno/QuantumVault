{"uid":"views/auth.py::get_recovery_bundle","name":"get_recovery_bundle","qualname":"get_recovery_bundle","kind":"function","file":"views/auth.py","line":534,"end_line":553,"language":"py","signature":"def get_recovery_bundle()","params":[],"returns":"","decorators":["auth_bp.route('/api/auth/recovery-bundle', methods=['GET'])","limiter.limit('10 per minute', key_func=_recovery_key)"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Return the QV-RECOVERY-1 bundle for a username, if one was generated.","description":"No authentication is required: a forgotten password by definition\nmeans the caller cannot log in. The returned values are opaque to\nanyone without the recovery code: ``encrypted_private_key_recovery``\nis AES-256-GCM ciphertext keyed by a PBKDF2 derivation of the\nrecovery code, so exposing it to an unauthenticated caller does not\nweaken the zero-knowledge guarantees.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"views/auth.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["views/auth.py::get_auth_controller"],"called_by":[]}
{"uid":"views/auth.py::reset_with_recovery","name":"reset_with_recovery","qualname":"reset_with_recovery","kind":"function","file":"views/auth.py","line":559,"end_line":615,"language":"py","signature":"def reset_with_recovery()","params":[],"returns":"","decorators":["auth_bp.route('/api/auth/reset-with-recovery', methods=['POST'])","limiter.limit('5 per hour', key_func=_recovery_key)","json_csrf_protect"],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Reset SRP credentials and the password-wrapped private key via QV-RECOVERY-1.","description":"The browser has already decrypted ``encrypted_private_key_recovery``\nusing a key derived from the recovery code and reconstructed the\naccount's public key from the recovered private key blob (see\n``derivePublicKeyFromPrivateBlob`` in ``static/js/qv-crypto.js``).\nThat reconstruction is supplied as ``public_key_proof``: AES-GCM\nauthentication means a wrong recovery code fails to decrypt at all,\nso only a caller who supplied the correct code can produce a\n``public_key_proof`` that matches the stored ``public_key``\nbyte-for-byte. The underlying keypair and ``public_key`` are not\nchanged; only the SRP verifier and the password-wrapping of the\nexisting private key blob are replaced.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"views/auth.py","members":[],"inferred_raises":[],"returns_value":true,"value":"","base_uids":[],"subclasses":[],"calls":["utils/mailer.py::mail_is_configured","utils/mailer.py::send_transactional_email","utils/security.py::audit_event","views/auth.py::get_auth_controller"],"called_by":[]}
