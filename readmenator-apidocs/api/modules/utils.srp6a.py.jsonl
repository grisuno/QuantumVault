{"uid":"utils/srp6a.py","name":"srp6a.py","qualname":"utils/srp6a.py","kind":"module","file":"utils/srp6a.py","line":1,"end_line":292,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Zero-knowledge SRP-6a authentication primitives for QuantumVault.","description":"This module implements the server side of a Secure Remote Password (SRP-6a)\nhandshake using the RFC 5054 2048-bit group with SHA-256. The user's password\nnever reaches the server: registration stores only ``salt`` and the password\nverifier ``v = g**x mod N``; authentication is a challenge/response that proves\nknowledge of the password without transmitting it.\n\nThe serialization scheme (\"QV-SRP-1\") is implemented identically in the browser\nmodule ``static/js/qv-crypto.js`` so both ends agree byte-for-byte:\n\n    - Every group element hashed (N, g, A, B, S) is encoded as a big-endian\n      integer left-padded to the byte length of N (256 bytes) via :func:`i2osp`.\n    - ``H`` is SHA-256 over the concatenation of byte strings.\n    - ``salt`` travels as a hex string; its raw bytes are used inside hashes.\n\nPublic functions perform the SRP math; :class:`SRPSessionStore` persists the\nephemeral per-login server state in Redis with a short time-to-live.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["utils/srp6a.py::N_HEX","utils/srp6a.py::N","utils/srp6a.py::N_BYTE_LENGTH","utils/srp6a.py::SESSION_TTL_SECONDS","utils/srp6a.py::EPHEMERAL_PRIVATE_BITS","utils/srp6a.py::i2osp","utils/srp6a.py::compute_k","utils/srp6a.py::compute_u","utils/srp6a.py::generate_server_challenge","utils/srp6a.py::compute_proofs","utils/srp6a.py::SRPSessionStore","utils/srp6a.py::hello","utils/srp6a.py::verify"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"call