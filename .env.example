# QuantumVault zero-trust environment template.
#
# Copy to .env, fill the values, and keep .env out of version control.
# `utils/utils.py` calls load_dotenv() at startup so any variable below is
# available to the application via os.environ.

# --- Object storage (self-hosted Garage) ------------------------------------
# Generated by scripts/garage-init.sh.
S3_ENDPOINT_URL=http://localhost:3900
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=quantumvault
S3_REGION=garage

# --- SRP session store + rate limiter --------------------------------------
STORAGE_URI=redis://localhost:6379

# --- Mail (transactional email) --------------------------------------------
# All MAIL_* variables below are read from the environment and override
# payload.json, so the SMTP endpoint can be set per host. Verify the transport
# from this machine with:  python scripts/email_tool.py test-smtp you@example.com
#
# Option A - AWS SES (recommended for a VPS or production). Verify a sender or
# domain in SES, leave the sandbox, then create SMTP credentials. MAIL_PASSWORD
# is the SES SMTP password, NOT your AWS console password.
MAIL_SERVER=email-smtp.us-east-2.amazonaws.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@quantumvault.pro
#
# Option B - Gmail from any Linux machine (low volume). Enable 2FA on the
# account, create an App Password, and use:
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=True
#   MAIL_USE_SSL=False
#   MAIL_USERNAME=your.address@gmail.com
#   MAIL_PASSWORD=<16-char app password>
#   MAIL_DEFAULT_SENDER=your.address@gmail.com
#
# If MAIL_USERNAME/MAIL_PASSWORD are empty the app skips sending and logs the
# confirmation link instead; recover it with:
#   python scripts/email_tool.py link <username>

# --- ClickSend (SMS verification + MFA) ------------------------------------
# Leave blank to skip SMS sending in development.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# --- Garage admin / RPC ----------------------------------------------------
# Used by scripts/garage-init.sh to authenticate against the admin API.
GARAGE_ADMIN_TOKEN=
GARAGE_RPC_SECRET=
GARAGE_KEY_NAME=quantumvault-app
GARAGE_ADMIN_URL=http://localhost:3903

# --- Flask -----------------------------------------------------------------
FLASK_DEBUG=False

# --- Feature flags -----------------------------------------------------------
# Set to 0 to disable the paid-plans/subscription blueprint and nav link
# entirely, for operators who only want the free, self-hosted core.
QV_ENABLE_SUBSCRIPTIONS=1

# --- Privacy hardening / Tor -------------------------------------------------
# These settings reduce the operational metadata an instance retains, for
# operators serving high-risk users (journalists, activists, dissidents)
# who reach the instance over Tor or another anonymizing network.
#
# Set to 0 to omit client IP addresses / User-Agent strings from the
# structured audit log (utils/security.py audit_event). Both default to 1
# (recorded), which is the right default for an instance that needs to
# investigate abuse reports.
QV_AUDIT_LOG_IP=1
QV_AUDIT_LOG_UA=1
#
# Set to 1 only when a reverse proxy you control sits in front of gunicorn
# and sets X-Forwarded-For/X-Forwarded-Proto (ProxyFix is then enabled).
# Leave this 0/unset when serving via a Tor onion service: the only
# "forwarded" address Tor's local onion-service listener would present is
# not a real client IP, so trusting X-Forwarded-For there would just
# substitute one meaningless address for another while disabling
# Werkzeug's own remote_addr handling.
QV_TRUSTED_PROXY=0
